{
  "name": "flipcard-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "FlipCard — the first primitive in an adaptive, manifest schema-driven, composable UI system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/flipcard.git"
  },
  "homepage": "https://microsoft.github.io/flipcard/",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/lint"
  ],
  "scripts": {
    "build": "npm run build:libs && npm run build:flipdeck",
    "build:libs": "npm run build -w @microsoft/flipcard-core && npm run build -w @microsoft/flipcard-themes && npm run build -w @microsoft/flipcard-react -w @microsoft/flipcard && npm run build -w @microsoft/flipcard-mcp",
    "build:flipdeck": "npm run build -w @microsoft/flipcard-showcase",
    "dev": "npm run dev -w @microsoft/flipcard-showcase",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,html}\"",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/themes/tsconfig.json --noEmit && tsc -p packages/mcp-server/tsconfig.json --noEmit && tsc -p packages/react/tsconfig.json --noEmit && tsc -p packages/vanilla/tsconfig.json --noEmit && tsc -p apps/showcase/tsconfig.json --noEmit",
    "clean": "rimraf --glob \"packages/*/dist\" \"apps/*/dist\" .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "ts-api-utils": {
      "typescript": "^6.0.3"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
