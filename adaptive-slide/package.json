{
  "name": "adaptive-slide",
  "version": "0.2.0",
  "description": "A schema-driven presentation builder/viewer built on Adaptive Cards with MCP App support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adaptive-slide-server": "./dist/plugins/mcp-app/server.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"require('node:fs').copyFileSync('src/plugins/mcp-app/viewer.html', 'dist/plugins/mcp-app/viewer.html')\"",
    "validate": "node scripts/validate.js",
    "test": "node --test tests/*.test.js",
    "lint": "tsc --noEmit",
    "serve": "node dist/plugins/mcp-app/server.js",
    "dev": "tsx src/plugins/mcp-app/server.ts"
  },
  "keywords": [
    "adaptive-cards",
    "presentation",
    "slides",
    "schema",
    "json-schema",
    "mcp",
    "mcp-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.1.5"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
