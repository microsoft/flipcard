{
  "name": "adaptive-slide",
  "version": "0.2.0",
  "description": "A schema-driven presentation builder/viewer built on Adaptive Cards with MCP App support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adaptive-slide-server": "./dist/plugins/mcp-app/server.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "tsup --config src/plugins/mcp-app/tsup.config.ts && node src/plugins/mcp-app/build-viewer.mjs",
    "validate": "node scripts/validate.js",
    "test": "node --test tests/*.test.js",
    "lint": "tsc --noEmit",
    "serve": "node dist/plugins/mcp-app/server.js",
    "dev": "npm run copy-assets && tsx src/plugins/mcp-app/server.ts"
  },
  "keywords": [
    "adaptive-cards",
    "presentation",
    "slides",
    "schema",
    "json-schema",
    "mcp",
    "mcp-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "happy-dom": "^21.0.4",
    "tsup": "^9.0.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
