{
  "name": "@microsoft/flipcard-mcp",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "flipcard-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --external @microsoft/flipcard-core && npm run build:viewer && tsc -p tsconfig.build.json",
    "build:viewer": "tsup --config tsup.viewer.config.ts && node scripts/build-viewer.mjs",
    "dev": "tsup src/index.ts src/cli.ts --format esm --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@microsoft/flipcard-core": "0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
