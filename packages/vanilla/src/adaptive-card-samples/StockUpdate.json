{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "speak": "Microsoft stock quote is not configured. No market price is available.",
  "body": [
    {
      "type": "TextBlock",
      "text": "Microsoft Corporation",
      "size": "medium",
      "weight": "bolder",
      "style": "heading",
      "wrap": true
    },
    { "type": "TextBlock", "text": "Nasdaq: MSFT · USD", "isSubtle": true, "wrap": true },
    {
      "type": "TextBlock",
      "id": "quote-status",
      "text": "Not configured — set VITE_STOCK_QUOTE_ENDPOINT to a public quote endpoint.",
      "wrap": true
    },
    { "type": "TextBlock", "id": "quote-price", "text": "—", "size": "extraLarge", "wrap": true },
    { "type": "TextBlock", "id": "quote-change", "text": "Change: unavailable", "wrap": true },
    {
      "type": "TextBlock",
      "id": "quote-as-of",
      "text": "Market timestamp: unavailable",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "id": "quote-provider",
      "text": "No quote provider configured",
      "wrap": true
    },
    { "type": "TextBlock", "id": "quote-open", "text": "Open: —", "wrap": true },
    { "type": "TextBlock", "id": "quote-high", "text": "High: —", "wrap": true },
    { "type": "TextBlock", "id": "quote-low", "text": "Low: —", "wrap": true },
    {
      "type": "TextBlock",
      "text": "Configured quotes refresh every 5 minutes while this page is visible and online. Source data may be delayed or end-of-day. Informational only; not financial advice.",
      "isSubtle": true,
      "wrap": true
    }
  ]
}
